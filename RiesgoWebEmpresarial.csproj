<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RiesgoWebEmpresarial</RootNamespace>
    <AssemblyName>RiesgoWebEmpresarial</AssemblyName>
    <!-- Id para 'dotnet user-secrets' (la API key nunca va en el repo) -->
    <UserSecretsId>riesgo-web-empresarial-5f2c1b9a-secrets</UserSecretsId>
    <!-- La Responses API del SDK oficial de OpenAI todavia es experimental -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK oficial de OpenAI para .NET (Responses API en OpenAI.Responses) -->
    <PackageReference Include="OpenAI" Version="2.13.0" />
    <!-- El id del paquete de PdfPig es "PdfPig"; el namespace es UglyToad.PdfPig -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- EF Core / SQL Server: conexion a la base de datos de la web SgrPlus -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Microsoft.Extensions.Configuration (+ .UserSecrets) NO se referencian explicitamente:
      en net10.0 con el SDK Web ya vienen en el framework compartido (Microsoft.AspNetCore.App).
      El binding de OpenAI:ApiKey / OpenAI:Model (User Secrets + env + appsettings) funciona igual.
    -->
  </ItemGroup>

</Project>

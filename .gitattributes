# Normaliza saltos de linea de archivos de texto
* text=auto eol=lf

*.cs      text eol=lf
*.razor   text eol=lf
*.cshtml  text eol=lf
*.csproj  text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.ps1     text eol=crlf

# Binarios: nunca aplicar conversion de EOL (corrompe el PDF)
*.pdf     binary
